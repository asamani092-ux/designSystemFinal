      "action":   {
        "primary":   { "surface": "{color.primary.600}", "hover": "{color.primary.700}", "active": "{color.primary.800}", "text": "{color.neutral.0}" },
        "secondary": { "surface": "{color.neutral.0}", "hover": "{color.neutral.100}", "border": "{color.neutral.300}", "text": "{color.neutral.800}" },
        "accent":    { "surface": "{color.secondary.400}", "hover": "{color.secondary.500}", "text": "{color.neutral.900}" },
        "ghost":     { "hover": "{color.primary.50}", "text": "{color.primary.600}" }
      },
      "focusRing": { "value": "rgba(149,26,65,0.35)" }
    },
    "dark": {
      "surface":  { "base": "{color.neutral.1000}", "raised": "#241a1e", "sunken": "#120c0e", "inverse": "{color.neutral.50}" },
      "text":     { "primary": "#ede7e9", "secondary": "#c4b9bc", "muted": "#9a8f92", "inverse": "{color.neutral.900}", "brand": "{color.primary.300}", "link": "{color.primary.300}" },
      "border":   { "subtle": "#2c2024", "default": "#3a2c31", "strong": "#4d3a40", "focus": "{color.primary.400}" },
      "action":   {
        "primary":   { "surface": "{color.primary.500}", "hover": "{color.primary.400}", "active": "{color.primary.600}", "text": "{color.neutral.0}" },
        "secondary": { "surface": "#241a1e", "hover": "#2c2024", "border": "#3a2c31", "text": "#ede7e9" },
        "accent":    { "surface": "{color.secondary.400}", "hover": "{color.secondary.300}", "text": "{color.neutral.900}" },
        "ghost":     { "hover": "rgba(149,26,65,0.18)", "text": "{color.primary.300}" }
      },
      "focusRing": { "value": "rgba(184,77,110,0.45)" }
    }
  },

