      "sm": {"value":"15px"}, "base": {"value":"16px"}, "lg": {"value":"18px"},
      "xl": {"value":"20px"}, "2xl": {"value":"24px"}, "3xl": {"value":"30px"},
      "4xl": {"value":"38px"}, "5xl": {"value":"48px"}
