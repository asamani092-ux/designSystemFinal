  "theme": {
    "light": {
      "surface":  { "base": "{color.neutral.50}", "raised": "{color.neutral.0}", "sunken": "{color.neutral.100}", "inverse": "{color.neutral.900}" },
      "text":     { "primary": "{color.neutral.800}", "secondary": "{color.neutral.600}", "muted": "{color.neutral.500}", "inverse": "{color.neutral.0}", "brand": "{color.primary.600}", "link": "{color.primary.600}" },
